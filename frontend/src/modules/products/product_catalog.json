    "address": {
      "label": "Calle y número",
      "type": "text",
      "maxLength": 200
    },
    "neighborhood": {
      "label": "Barrio",
      "type": "text",
      "maxLength": 100
    },
    "surface": {
      "label": "Superficie (m²)",
      "type": "number",
      "min": 0.01,
      "max": 100000000000,
      "step": "0.01"
    },
