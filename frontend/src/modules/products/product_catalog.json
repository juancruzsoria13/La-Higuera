      "type": "number",
      "min": 0,
      "max": 100,
      "step": "1"
    },
    "bathrooms": {
      "label": "Baños",
      "type": "number",
      "min": 0,
      "max": 100,
      "step": "1"
    },
    "garages": {
      "label": "Cocheras",
      "type": "number",
      "min": 0,
      "max": 100,
      "step": "1"
    },
    "credit_eligible": {
      "label": "Apto crédito",
      "type": "select",
      "options": [
        {
          "id": "si",
          "name": "Sí"
        },
        {
          "id": "no",
          "name": "No"
        }
      ]
    },
    "maps_url": {
      "label": "Ubicación en Google Maps",
