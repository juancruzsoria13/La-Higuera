      "type": "number",
      "min": 1886,
      "max": 2100,
      "step": "1"
    },
    "mileage": {
      "label": "Kilometraje (km)",
      "type": "number",
      "min": 0,
      "max": 10000000,
      "step": "1"
    },
    "fuel": {
