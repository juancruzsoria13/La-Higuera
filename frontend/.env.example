# Copiar a frontend/.env.local y completar con los valores del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Clave publishable (sb_publishable_...) o la anon heredada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# URL pública del sitio; se usa en el enlace de confirmación de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Dirección de la API de Python (backend/). Solo la usa el servidor de Next.js.
API_URL=http://127.0.0.1:8000
