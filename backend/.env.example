# Copiar a backend/.env y completar con los valores del proyecto Supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Clave secret (sb_secret_...) o service_role heredada. Solo la usa este servidor
# para eliminar cuentas y para los scripts de mantenimiento. Nunca exponerla al navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY
# Orígenes permitidos para CORS, separados por coma. El frontend llama a la API desde el
# servidor de Next.js, así que normalmente puede quedar vacío.
CORS_ORIGINS=
